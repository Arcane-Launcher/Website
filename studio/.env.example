# Copy to .env in this folder. Everything here is safe to commit-adjacent
# (no secrets), but .env is gitignored anyway.

# Required. From https://www.sanity.io/manage -> your project -> Project ID.
SANITY_STUDIO_PROJECT_ID=reynj4ho

# Optional, defaults to "production".
SANITY_STUDIO_DATASET=production

# Optional. The public website address. With it, published posts get an
# "Open on site" action in the Studio.
SANITY_STUDIO_SITE_URL=http://localhost:3001

# Optional. The hosted Studio's name for `npm run deploy`, giving
# https://<name>.sanity.studio. Sanity asks for one on first deploy if unset.
# SANITY_STUDIO_HOST=arcane-news
